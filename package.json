{
  "name": "sentinelcore",
  "version": "1.0.0",
  "private": true,
  "description": "SentinelCore local development launcher",
  "scripts": {
    "dev": "node backend/scripts/dev.mjs start",
    "dev:restart": "node backend/scripts/dev.mjs restart",
    "dev:rebuild": "node backend/scripts/dev.mjs rebuild",
    "dev:stop": "node backend/scripts/dev.mjs stop",
    "dev:status": "node backend/scripts/dev.mjs status",
    "dev:logs": "node backend/scripts/dev.mjs logs",
    "build": "npm --prefix frontend run build"
  }
}
